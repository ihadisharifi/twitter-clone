<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="650.0" prefWidth="600.0" styleClass="app-root" stylesheets="@../styles/twitter.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.BookmarksController">
    <children>

        <VBox styleClass="app-root">
            <children>

                <!-- Top bar -->
                <StackPane prefHeight="54.0" styleClass="top-bar">
                    <children>
                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" StackPane.alignment="CENTER_LEFT">
                            <padding>
                                <Insets left="12.0" right="12.0" />
                            </padding>
                            <children>
                                <Button onAction="#handleOpenDrawer" styleClass="avatar-button">
                                    <graphic>
                                        <StackPane>
                                            <children>
                                                <Circle fill="#262626" radius="16.0" stroke="#333333" strokeWidth="1.0" />
                                                <Label style="-fx-text-fill: #71767b; -fx-font-size: 14;" text="👤" />
                                            </children>
                                        </StackPane>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                        <Label styleClass="x-logo" text="𝕏" StackPane.alignment="CENTER">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                </StackPane>

                <!-- Page title -->
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="12.0" style="-fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="12.0" right="16.0" />
                    </padding>
                    <children>
                        <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-cursor: hand; -fx-padding: 4 8;" text="←" />
                        <Label text="Bookmarks" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Scrollable timeline for bookmarked tweets -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #000000; -fx-background-color: #000000;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="bookmarksContainer" spacing="1.0" style="-fx-background-color: #000000;" />
                    </content>
                </ScrollPane>

                <!-- Bottom navigation -->
                <HBox alignment="CENTER" prefHeight="56.0" spacing="0.0" styleClass="bottom-bar">
                    <children>
                        <Button maxWidth="Infinity" minHeight="56.0" onAction="#handleGoToHome" styleClass="bottom-nav-item" text="🏠" HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Button>
                        <Button maxWidth="Infinity" minHeight="56.0" onAction="#handleGoToSearch" styleClass="bottom-nav-item" text="🔍" HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Button>
                        <Button maxWidth="Infinity" minHeight="56.0" onAction="#handleCreatePost" styleClass="bottom-nav-item" text="➕" HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Button>
                        <Button maxWidth="Infinity" minHeight="56.0" onAction="#handleGoToProfile" styleClass="bottom-nav-item" text="👤" HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Side drawer overlay -->
        <HBox fx:id="drawerOverlay" managed="false" mouseTransparent="true" visible="false" styleClass="drawer-overlay">
            <children>
                <VBox fx:id="drawerPanel" prefWidth="300.0" spacing="0.0" styleClass="drawer-panel">
                    <children>
                        <VBox spacing="6.0" styleClass="drawer-header">
                            <padding>
                                <Insets bottom="16.0" left="16.0" right="16.0" top="20.0" />
                            </padding>
                            <children>
                                <StackPane alignment="CENTER_LEFT" prefHeight="48.0">
                                    <children>
                                        <Circle fill="#262626" radius="24.0" stroke="#333333" strokeWidth="1.0" />
                                        <Label style="-fx-text-fill: #71767b; -fx-font-size: 22;" text="👤" />
                                    </children>
                                </StackPane>
                                <Label fx:id="drawerDisplayName" styleClass="drawer-display-name" text="User">
                                    <font>
                                        <Font name="System Bold" size="17.0" />
                                    </font>
                                </Label>
                                <Label fx:id="drawerUsername" styleClass="drawer-username" text="@user">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <HBox spacing="16.0" style="-fx-padding: 8 0 0 0;">
                                    <children>
                                        <HBox spacing="4.0">
                                            <children>
                                                <Label fx:id="drawerFollowingCount" styleClass="drawer-stat-count" text="0" />
                                                <Label styleClass="drawer-stat-label" text="Following" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="4.0">
                                            <children>
                                                <Label fx:id="drawerFollowersCount" styleClass="drawer-stat-count" text="0" />
                                                <Label styleClass="drawer-stat-label" text="Followers" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Region style="-fx-pref-height: 1; -fx-background-color: #333333;" />

                        <VBox spacing="4.0" style="-fx-padding: 8 0 0 0;" VBox.vgrow="ALWAYS">
                            <children>
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" minHeight="48.0" onAction="#handleGoToProfile" styleClass="drawer-menu-item" text="👤  Profile" />
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" minHeight="48.0" onAction="#handleGoToBookmarks" styleClass="drawer-menu-item" text="🔖  Bookmarks" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" minHeight="48.0" onAction="#handleLogout" styleClass="drawer-menu-item, drawer-logout" text="🚪  Log out" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Region fx:id="drawerDimmer" onMouseClicked="#handleCloseDrawer" styleClass="drawer-dimmer" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

    </children>
</StackPane>
